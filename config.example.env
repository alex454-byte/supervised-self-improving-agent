# Copy to .env (git-ignored) and export before running. Every value here is a placeholder.

# Where the hash-chained ledger lives (default: ./state/ledger.jsonl).
AGENT_LEDGER=/path/to/agent/state/ledger.jsonl
# Cooldowns and per-run folders (default: ./state).
AGENT_STATE=/path/to/agent/state
# Optional: a private, versioned bucket for bin/ledger_backup.py.
AGENT_LEDGER_BUCKET=gs://YOUR-LEDGER-BUCKET

# For setup/clone-with-github-app.sh (run as the agent OS user).
AGENT_APP_ID=YOUR_GITHUB_APP_ID
AGENT_APP_KEY=/path/to/agent-user/.config/supervised-agent/github-app.pem
AGENT_REPO_URL=https://github.com/YOUR-ORG/YOUR-AGENT-REPO.git

# Not environment settings, on purpose (the agent's environment must not be able to move them).
# Edit these constants in the code instead:
#   evaluator/evaluate.py  PINS (default /opt/supervised-agent/pins.json), AGENT_USER (default agentbot)
#   bin/heavy_cycle.py     PINS (must match), WRITER (CLI and model that writes changes)
#   bin/review_panel.py    MODELS (one model per reviewer family), ROLES
#   bin/llm_call.py        WEEKLY_TOKEN_CAP (tokens per CLI per ISO week)
